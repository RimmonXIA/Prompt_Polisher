# Provider: openai, deepseek, anthropic, google, zhipu, aliyun, etc.
# LLM_PROVIDER=openai

# API keys (read from environment; optional .env file is loaded automatically)
# OpenAI:
# OPENAI_API_KEY=
# DeepSeek:
# DEEPSEEK_API_KEY=
# Anthropic:
# ANTHROPIC_API_KEY=
# Google (Gemini):
# GEMINI_API_KEY=

# Optional: single key for any OpenAI-compatible provider
# LLM_API_KEY=

# Optional: override API base (otherwise DeepSeek uses https://api.deepseek.com/v1)
# LLM_API_BASE=
# OPENAI_API_BASE=

# Models (optional overrides)
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat
# LLM_MODEL=

# LLM_TEMPERATURE=0.2
# MAX_CRITIC_ITERATIONS=3

# Optional: process-style score on draft before the text Critic (extra LLM call; default off)
# CRITIC_USE_PRM=false
# PRM_MODEL=
# PRM_MIN_SCORE=0.45
# PRM_TEMPERATURE=0

# Treat raw prompt as written by a trusted author (default true). Set false for pasted/untrusted text.
# AUTHOR_TRUST_MODE=true

# Optional: directory of .txt prompt overrides (same filenames as package defaults; missing files fall back to built-ins).
# PROMPTS_DIR=/path/to/my/prompts

# Threat gate after Radar: stop before routing/compile/critic/router (see gate.should_abort_after_radar).
# ABORT_ON_HEURISTIC_INJECTION=true
# ABORT_ON_RADAR_HIGH=false

# Logging & observability (development)
# LOG_LEVEL=INFO
# LOG_JSON=0
# LOG_PROMPT_PREVIEWS=0

# Optional: LangSmith tracing (LangChain / LangGraph) — no extra code; set API key + project
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=prompt-polisher

# --- Langfuse (only after you create a project in the Langfuse UI) ---
# Fill the three lines below, then: uv run prompt-polisher-langfuse-check
# LANGFUSE_TRACING=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Optional — set if US cloud or self-hosted (EU cloud often works without this):
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
